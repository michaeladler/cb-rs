#compdef cb

autoload -U is-at-least

_cb() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-n+[Clipboard to use, instead of the default]:NAME:_default' \
'--name=[Clipboard to use, instead of the default]:NAME:_default' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_cb_commands" \
"*::: :->cb-rs" \
&& ret=0
    case $state in
    (cb-rs)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:cb-command-$line[1]:"
        case $line[1] in
            (copy)
_arguments "${_arguments_options[@]}" : \
'-n+[Clipboard to use, instead of the default]:NAME:_default' \
'--name=[Clipboard to use, instead of the default]:NAME:_default' \
'-a[add to the recorded paths instead of replacing them]' \
'--amend[Add to the recorded paths instead of replacing them]' \
'-h[Print help]' \
'--help[Print help]' \
'*::paths -- Files or directories to copy:_files' \
&& ret=0
;;
(cut)
_arguments "${_arguments_options[@]}" : \
'-n+[Clipboard to use, instead of the default]:NAME:_default' \
'--name=[Clipboard to use, instead of the default]:NAME:_default' \
'-a[add to the recorded paths instead of replacing them]' \
'--amend[Add to the recorded paths instead of replacing them]' \
'-h[Print help]' \
'--help[Print help]' \
'*::paths -- Files or directories to move on paste:_files' \
&& ret=0
;;
(paste)
_arguments "${_arguments_options[@]}" : \
'-d+[Destination directory, defaults to the current one]:DIRECTORY:_files' \
'--directory=[Destination directory, defaults to the current one]:DIRECTORY:_files' \
'--on-conflict=[What to do when a destination file already exists]:ON_CONFLICT:_default' \
'-n+[Clipboard to use, instead of the default]:NAME:_default' \
'--name=[Clipboard to use, instead of the default]:NAME:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-n+[Clipboard to use, instead of the default]:NAME:_default' \
'--name=[Clipboard to use, instead of the default]:NAME:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_cb__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:cb-help-command-$line[1]:"
        case $line[1] in
            (copy)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(cut)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(paste)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_cb_commands] )) ||
_cb_commands() {
    local commands; commands=(
'copy:Record files to be copied when pasted, leaving the originals in place' \
'cut:Record files to be moved when pasted. The originals stay in place until then' \
'paste:Write the clipboard'\''s files into the current directory' \
'list:List what the clipboard holds' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'cb commands' commands "$@"
}
(( $+functions[_cb__subcmd__copy_commands] )) ||
_cb__subcmd__copy_commands() {
    local commands; commands=()
    _describe -t commands 'cb copy commands' commands "$@"
}
(( $+functions[_cb__subcmd__cut_commands] )) ||
_cb__subcmd__cut_commands() {
    local commands; commands=()
    _describe -t commands 'cb cut commands' commands "$@"
}
(( $+functions[_cb__subcmd__help_commands] )) ||
_cb__subcmd__help_commands() {
    local commands; commands=(
'copy:Record files to be copied when pasted, leaving the originals in place' \
'cut:Record files to be moved when pasted. The originals stay in place until then' \
'paste:Write the clipboard'\''s files into the current directory' \
'list:List what the clipboard holds' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'cb help commands' commands "$@"
}
(( $+functions[_cb__subcmd__help__subcmd__copy_commands] )) ||
_cb__subcmd__help__subcmd__copy_commands() {
    local commands; commands=()
    _describe -t commands 'cb help copy commands' commands "$@"
}
(( $+functions[_cb__subcmd__help__subcmd__cut_commands] )) ||
_cb__subcmd__help__subcmd__cut_commands() {
    local commands; commands=()
    _describe -t commands 'cb help cut commands' commands "$@"
}
(( $+functions[_cb__subcmd__help__subcmd__help_commands] )) ||
_cb__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'cb help help commands' commands "$@"
}
(( $+functions[_cb__subcmd__help__subcmd__list_commands] )) ||
_cb__subcmd__help__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'cb help list commands' commands "$@"
}
(( $+functions[_cb__subcmd__help__subcmd__paste_commands] )) ||
_cb__subcmd__help__subcmd__paste_commands() {
    local commands; commands=()
    _describe -t commands 'cb help paste commands' commands "$@"
}
(( $+functions[_cb__subcmd__list_commands] )) ||
_cb__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'cb list commands' commands "$@"
}
(( $+functions[_cb__subcmd__paste_commands] )) ||
_cb__subcmd__paste_commands() {
    local commands; commands=()
    _describe -t commands 'cb paste commands' commands "$@"
}

if [ "$funcstack[1]" = "_cb" ]; then
    _cb "$@"
else
    compdef _cb cb
fi
